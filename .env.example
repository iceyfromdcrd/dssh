# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_server_id_here

# Security: Comma-separated list of authorized Discord User IDs (Strict Whitelist)
AUTHORIZED_USER_IDS=123456789012345678

# Monitoring & Alerting Channel ID
ALERT_CHANNEL_ID=112233445566778899

# Monitoring & Auto-Sync Controls (true/false)
ENABLE_AUTO_SYNC=true
POLL_INTERVAL_SEC=30

# Alert Toggles & Thresholds (true/false)
ENABLE_CPU_ALERTS=true
ALERT_CPU_THRESHOLD=85

ENABLE_RAM_ALERTS=true
ALERT_RAM_THRESHOLD=90

# Optional Public URL (auto-detected on Render, or custom domain e.g. https://dssh.yourdomain.com)
PUBLIC_URL=
